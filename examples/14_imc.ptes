// Calcula o IMC (peso / altura²) e classifica.
ALGORITMO imc;
VARIAVEIS
  peso, altura, imc : REAL;
INICIO
  ESCREVA("Peso (kg) e altura (m):");
  LEIA(peso, altura);
  imc <- peso / (altura * altura);
  ESCREVA("IMC: ", imc);
  SE imc < 18.5 ENTAO
    ESCREVA("Abaixo do peso");
  SENAO
    SE imc < 25 ENTAO
      ESCREVA("Peso normal");
    SENAO
      ESCREVA("Acima do peso");
    FIMSE
  FIMSE
FIM;
